# Passphrase de chiffrement de l'archive des bases de données (obligatoire, AES-256)
BACKUP_ENCRYPTION_PASSPHRASE=change-me

# Activation de la copie distante
REMOTE_ENABLED=false

# Destinataire SSH
REMOTE_USER=backupuser
REMOTE_HOST=backup.example.org
REMOTE_PORT=22
REMOTE_BASE_PATH=/var/backups/sauvetage
REMOTE_SSH_KEY=id_ed25519

# Rétention locale des snapshots complets (jours)
KEEP_DAYS=30

# Rétention de l'archive soft delete des documents sur le serveur distant (jours)
ARCHIVE_RETENTION_DAYS=30

# Restauration des documents lors d'un restore (true/false)
RESTORE_DOCS=true
