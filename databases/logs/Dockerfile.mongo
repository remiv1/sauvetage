FROM docker.io/library/mongo:7.0.16

# Installer des outils supplémentaires
RUN apt-get update && apt-get install -y bash gettext

# Copier les fichiers d'environnement et scripts
COPY config/env/.env.db_logs /tmp/.env.db_logs
COPY databases/logs/init/02_immutable_collections.js /docker-entrypoint-initdb.d/02_immutable_collections.js
COPY databases/logs/init/03_collections_rotation.js /docker-entrypoint-initdb.d/03_collections_rotation.js
COPY databases/logs/init/00_generate_config.sh /tmp/00_generate_config.sh
COPY databases/logs/init/*.js.pattern /tmp/

# Rendre exécutable et générer les fichiers JS
RUN chmod +x /tmp/00_generate_config.sh && \
    set -a && \
    . /tmp/.env.db_logs && \
    set +a && \
    cd /tmp && \
    ./00_generate_config.sh && \
    mkdir -p /docker-entrypoint-initdb.d && \
    cp /tmp/*.js /docker-entrypoint-initdb.d/ 2>/dev/null || true
