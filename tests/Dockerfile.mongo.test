FROM docker.io/library/mongo:7.0.16

# Installer des outils supplémentaires
RUN apt-get update && apt-get install -y bash gettext

# Copier les scripts d'initialisation sans inclure les identifiants dans l'image
COPY tests/init_mongo/02_immutable_collections.js /docker-entrypoint-initdb.d/02_immutable_collections.js
COPY tests/init_mongo/03_collections_rotation.js /docker-entrypoint-initdb.d/03_collections_rotation.js
COPY tests/init_mongo/01_create_db_users.js.pattern /tmp/01_create_db_users.js.pattern
COPY tests/init_mongo/01_create_db_users.sh /docker-entrypoint-initdb.d/01_create_db_users.sh

RUN chmod +x /docker-entrypoint-initdb.d/01_create_db_users.sh

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD mongosh --eval "db.adminCommand('ping')" || exit 1